# =========================================================
# .env.example -> 复制为 .env 后填写。切勿把真实 Key 提交到仓库。
# 无 DEEPSEEK_API_KEY 时自动进入 mock 模式，可跑通全流程与全部测试。
# =========================================================

# ---- LLM: DeepSeek 官方 API（OpenAI 兼容）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名不要写死在代码里，这里覆盖 config/settings.yaml 中的默认值
RAG_LLM__MODEL=deepseek-chat

# ---- 公网 / 部门看板（也可直接写在 config/settings.yaml）----
# 对外域名，只用于控制台展示分享地址
# RAG_SERVER__PUBLIC_URL=https://zhidu.example.edu.cn
# 问答接口令牌（非空则 /chat* /kb/* 需要 X-Access-Token 或 ?token=）
# RAG_SERVER__PUBLIC_ACCESS_TOKEN=
# 部门看板令牌（强烈建议设置，看板里有全校提问统计）
# RAG_DEPT_CONSOLE__TOKEN=
# 周报发信密码：SMTP 登录密码只放环境变量，不写进 YAML
# SMTP_PASSWORD=

# ---- 全局模式开关 ----
# 强制走 mock（不打网络、不下载模型）；留空表示按配置自动判定
RAG_FORCE_MOCK=

# ---- 任一层可实现"配置覆盖"，规则：RAG_<SECTION>__<KEY>=value ----
# 例如临时把 Top-N 改成 8、阈值改成 0.6：
# RAG_RETRIEVAL__TOP_N=8
# RAG_RETRIEVAL__SCORE_THRESHOLD=0.6
# 打开 GPU（auto = 有 CUDA 就用，无则 CPU）：
# RAG_EMBEDDING__DEVICE=cuda
# RAG_RERANKER__DEVICE=cuda

# ---- 可选：改用本地 OpenAI 兼容服务（LM Studio / Ollama），不需要 Key ----
# LM Studio：Developer -> Start Server（默认 http://127.0.0.1:1234/v1）
# RAG_LLM__PROVIDER=lmstudio
# RAG_LLM__BASE_URL=http://127.0.0.1:1234/v1
# RAG_LLM__MODEL=qwen3.5-4b-uncensored-hauhaucs-aggressive
#
# Ollama：ollama serve（默认 http://127.0.0.1:11434/v1）
# RAG_LLM__PROVIDER=ollama
# RAG_LLM__BASE_URL=http://127.0.0.1:11434/v1
# RAG_LLM__MODEL=qwen2.5:7b
